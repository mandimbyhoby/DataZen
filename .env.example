# Configuration de production DataZen
#
# Copiez ce fichier en `.env`, renseignez les valeurs, puis exportez-les dans
# l'environnement du processus avant de lancer waitress. `.env` est ignoré par
# git : aucun secret ne doit être versionné.
#
# Exemple de chargement sous PowerShell :
#   Get-Content .env | ForEach-Object {
#       if ($_ -match '^\s*([^#][^=]*)=(.*)$') {
#           [Environment]::SetEnvironmentVariable($matches[1].Trim(), $matches[2].Trim())
#       }
#   }
#
# Sous Linux / macOS :
#   set -a; . ./.env; set +a

# --- Indispensable -----------------------------------------------------------

# 0 en production. À 1, Django affiche les pages d'erreur détaillées et sert
# les fichiers statiques lui-même : jamais en production.
DJANGO_DEBUG=0

# Clé secrète. Obligatoire quand DJANGO_DEBUG=0 : l'application refuse de
# démarrer sans elle. Générez-la avec :
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Hôtes autorisés, séparés par des virgules. Incluez le domaine public et, si
# un contrôle de santé passe par l'IP, l'adresse correspondante.
DJANGO_ALLOWED_HOSTS=datazen.example.com

# 1 si le site est servi en HTTPS. Active HSTS, la redirection SSL et les
# cookies `Secure`. Laissez à 0 uniquement pour un test local en HTTP.
DJANGO_HTTPS=1

# --- E-mail ------------------------------------------------------------------

# Sans DJANGO_EMAIL_HOST, les messages sont écrits dans la console du serveur :
# la réinitialisation de mot de passe reste alors sans effet pour l'utilisateur.
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USER=
DJANGO_EMAIL_PASSWORD=
DJANGO_DEFAULT_FROM_EMAIL=DataZen <no-reply@example.com>

# 587 -> STARTTLS, 465 -> SSL implicite. Les valeurs par défaut découlent du
# port ; ne surchargez que si votre fournisseur impose l'inverse.
# DJANGO_EMAIL_TLS=1
# DJANGO_EMAIL_SSL=0
# DJANGO_EMAIL_TIMEOUT=15

# --- Anti-force brute sur la connexion ---------------------------------------

# Tentatives échouées autorisées par identifiant, puis par adresse IP, sur la
# fenêtre indiquée en secondes (900 = 15 minutes).
DJANGO_LOGIN_MAX_PER_USER=5
DJANGO_LOGIN_MAX_PER_IP=20
DJANGO_LOGIN_WINDOW=900
